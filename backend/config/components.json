{
  "_comment": "组件识别规则（2026-11-04 组件类型归一：换环境只改本文件，不改代码）。role: ingress/gateway/app/bigdata/middleware/db/third_party。识别优先级：product_role（产品码显式覆盖）> kind_role（组件类型默认，vendor 中立——腾讯云 cvm/cdb/clb/cos、阿里云 ecs/rds/slb/oss、自建 vmware/kvm 同语义同类型）> name_rules（主机命名规则）> 应用层兜底。kind: host=云主机 / db=数据库 / lb=负载均衡 / object_storage=对象存储 / cache=缓存 / cdn=CDN / mq=消息队列 / search=搜索引擎 / k8s=容器服务 / waf=WAF / apm=APM 服务。 2026-11-12：name_rules 支持可选 scope（private/public/any，缺省 any）——客户可给自建软件规则限定私有云，避免公有云主机名里的软件关键字改变架构角色；代码不强制回写。",
  "product_role": {
    "host": [
      "app",
      "主机（Agent）"
    ]
  },
  "kind_role": {
    "host": [
      "app",
      "云主机"
    ],
    "db": [
      "db",
      "数据库"
    ],
    "lb": [
      "gateway",
      "负载均衡"
    ],
    "object_storage": [
      "db",
      "对象存储"
    ],
    "cache": [
      "middleware",
      "缓存"
    ],
    "cdn": [
      "gateway",
      "CDN"
    ],
    "mq": [
      "middleware",
      "消息队列"
    ],
    "search": [
      "bigdata",
      "搜索引擎"
    ],
    "k8s": [
      "app",
      "容器服务"
    ],
    "waf": [
      "gateway",
      "WAF"
    ],
    "apm": [
      "middleware",
      "APM 服务"
    ]
  },
  "name_rules": [
    {
      "pattern": "emr",
      "role": "bigdata",
      "component": "EMR 大数据集群"
    },
    {
      "pattern": "kafka",
      "role": "bigdata",
      "component": "Kafka"
    },
    {
      "pattern": "^ds-\\d+",
      "role": "bigdata",
      "component": "数据计算集群"
    },
    {
      "pattern": "milvus",
      "role": "bigdata",
      "component": "Milvus 向量库"
    },
    {
      "pattern": "superset",
      "role": "bigdata",
      "component": "Superset BI"
    },
    {
      "pattern": "cassandra",
      "role": "db",
      "component": "Cassandra"
    },
    {
      "pattern": "apollo[-_]?data|database|pgsql|mysql|paas-write",
      "role": "db",
      "component": ""
    },
    {
      "pattern": "apollo",
      "role": "third_party",
      "component": "Apollo 配置中心"
    },
    {
      "pattern": "sentry",
      "role": "third_party",
      "component": "Sentry 错误追踪"
    },
    {
      "pattern": "chat-?gpt|openclaw",
      "role": "third_party",
      "component": "ChatGPT/OpenAI"
    },
    {
      "pattern": "skywalking",
      "role": "middleware",
      "component": "SkyWalking APM"
    },
    {
      "pattern": "nginx",
      "role": "gateway",
      "component": "Nginx"
    },
    {
      "pattern": "worker-k8s|kubernetes|k8s",
      "role": "app",
      "component": "K8s 工作节点"
    },
    {
      "pattern": "jumpserver|堡垒机",
      "role": "gateway",
      "component": "Jumpserver 堡垒机"
    },
    {
      "pattern": "pritunl|vpn",
      "role": "gateway",
      "component": "Pritunl VPN"
    }
  ],
  "clustered_components": [
    "Cassandra",
    "Kafka",
    "EMR 大数据集群",
    "缓存",
    "数据库",
    "数据计算集群",
    "搜索引擎",
    "K8s 工作节点"
  ]
}
